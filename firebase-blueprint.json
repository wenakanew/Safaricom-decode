{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "email": { "type": "string", "format": "email", "description": "The user's email." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID who owns this transaction." },
        "amount": { "type": "number", "description": "The transaction amount." },
        "type": { 
          "type": "string", 
          "enum": ["income", "expense", "send", "receive", "paybill"], 
          "description": "The type of transaction." 
        },
        "category": { "type": "string", "description": "The category of the transaction." },
        "date": { "type": "string", "format": "date-time", "description": "The date of the transaction." },
        "description": { "type": "string", "description": "A brief description of the transaction." }
      },
      "required": ["uid", "amount", "type", "category", "date", "description"]
    },
    "CreditScore": {
      "title": "Credit Score",
      "description": "User's calculated credit score.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID." },
        "score": { "type": "number", "description": "The score from 0 to 1000." },
        "rating": { "type": "string", "description": "The credit rating (e.g., Excellent, Good, Fair)." },
        "explanation": { "type": "string", "description": "Explanation for the score." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the score was last updated." }
      },
      "required": ["uid", "score", "rating", "explanation", "updatedAt"]
    },
    "Insight": {
      "title": "Insight",
      "description": "Financial insights for the user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID." },
        "totalIncome": { "type": "number", "description": "Total income calculated." },
        "totalExpenses": { "type": "number", "description": "Total expenses calculated." },
        "savingsPotential": { "type": "number", "description": "Calculated savings potential." },
        "summary": { "type": "string", "description": "A short summary of the insights." },
        "message": { "type": "string", "description": "A detailed insight message." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the insight was last updated." }
      },
      "required": ["uid", "totalIncome", "totalExpenses", "savingsPotential", "summary", "message", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions."
    },
    "/credit_scores/{userId}": {
      "schema": "CreditScore",
      "description": "User credit scores."
    },
    "/insights/{userId}": {
      "schema": "Insight",
      "description": "User financial insights."
    }
  }
}
